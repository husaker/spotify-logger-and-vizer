{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotify-logger-and-vizer",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
