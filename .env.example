# Local Spotify reauthorization only. Never commit your populated .env.
USER_SHEET_ID=your_google_workbook_id
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
FERNET_KEY=your_existing_fernet_key
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8766/callback
# Optional alternative to FERNET_KEY when using an existing v2 authorization:
# TOKEN_ENCRYPTION_KEY=your_existing_base64url_encoded_32_byte_key
